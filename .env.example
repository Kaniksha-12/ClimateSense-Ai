# Optional settings - the backend and frontend work without any of these.
# Copy to .env (never commit the real .env; it is git-ignored).

# Backend
# SQLAlchemy database URL; defaults to a SQLite file at backend/data/climatesense.db
DATABASE_URL=sqlite:///./data/climatesense.db

# Comma-separated explicit browser origins; wildcards (*) are rejected.
# Defaults to the local Vite dev/preview origins.
CORS_ORIGINS=http://localhost:5173

# Frontend
# Vite development proxy target only
VITE_BACKEND_URL=http://127.0.0.1:8000

# Browser API base for a deployed frontend/API pair; empty means same-origin /api
VITE_API_BASE_URL=
